{
  "name": "dsh-skill-manager",
  "version": "0.2.0",
  "description": "技能管理器：设置→技能，扫描用户技能根目录、列出/删除/撤回技能（host + client 一体包）",
  "type": "module",
  "scripts": {
    "test": "node test/delete-undo.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuogusa/dsh-skill-manager.git"
  },
  "homepage": "https://github.com/tuogusa/dsh-skill-manager"
}
